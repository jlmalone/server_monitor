#!/usr/bin/env bash
set -euo pipefail
export AGENT_CLI_CREDENTIAL_STORE=file
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
ROOT="$(cd "$(dirname "$SOURCE")" && pwd)"
launcher="${ROOT}/cursor-file-agent"
case "${1:-}" in
  login|logout|status|whoami|models|about|update|mcp|plugin|worker|install-shell-integration|uninstall-shell-integration)
    exec "$launcher" "$@"
    ;;
esac
exec "$launcher" --yolo --sandbox disabled --trust --model composer-2.5 "$@"
