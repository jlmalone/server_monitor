#!/usr/bin/env bash
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
ROOT="$(cd "$(dirname "$SOURCE")" && pwd)"
# shellcheck source=agent-dangerously-common.sh
source "${ROOT}/agent-dangerously-common.sh"

latest_grok_download() {
  ls -1 "${HOME}/.grok/downloads"/grok-*-macos-aarch64 2>/dev/null | sort | tail -1
}

resolve_grok_real_link() {
  local link="${HOME}/.grok/bin/grok.real"
  local dir target
  if [[ -L "$link" ]]; then
    dir="$(cd "$(dirname "$link")" && pwd)"
    target="$(readlink "$link")"
    [[ "$target" != /* ]] && target="${dir}/${target}"
    if [[ -x "$target" ]]; then
      printf '%s\n' "$target"
      return 0
    fi
  elif [[ -x "$link" ]]; then
    printf '%s\n' "$link"
    return 0
  fi
  latest_grok_download
}

GROK_FALLBACK="$(resolve_grok_real_link)"
REAL="$(agent_dangerously_resolve_real GROK_REAL "$GROK_FALLBACK")"
DEFAULT=(
  --always-approve
  --permission-mode bypassPermissions
  --sandbox off
  --model grok-4.6
  --reasoning-effort low
)

case "${1:-}" in
  login|logout|mcp|update|completion|--help|-h|--version|-v)
    exec "$REAL" "$@"
    ;;
esac

exec "$REAL" "${DEFAULT[@]}" "$@"
